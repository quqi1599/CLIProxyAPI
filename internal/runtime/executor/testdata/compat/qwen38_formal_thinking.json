{
  "policy_id": "openai_compat.qwen38.formal_hybrid_thinking",
  "compat_kind": "qwen",
  "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
  "cases": [
    {
      "name": "disabled thinking remains disabled",
      "model": "qwen3.8-max",
      "input": {
        "model": "configured-qwen-alias",
        "messages": [
          {
            "role": "user",
            "content": "hi"
          }
        ],
        "enable_thinking": false,
        "reasoning_effort": "none",
        "reasoning": {
          "effort": "none"
        },
        "thinking": {
          "type": "disabled",
          "budget_tokens": 0
        },
        "thinking_budget": 0,
        "temperature": 0.2
      },
      "expected": {
        "model": "configured-qwen-alias",
        "messages": [
          {
            "role": "user",
            "content": "hi"
          }
        ],
        "enable_thinking": false,
        "temperature": 0.2
      },
      "downgrades": []
    },
    {
      "name": "medium effort remains medium",
      "model": "qwen3.8-max",
      "input": {
        "model": "configured-qwen-medium-alias",
        "reasoning_effort": "medium",
        "thinking_budget": 4096
      },
      "expected": {
        "model": "configured-qwen-medium-alias",
        "enable_thinking": true,
        "reasoning_effort": "medium"
      },
      "downgrades": []
    },
    {
      "name": "high effort becomes xhigh",
      "model": "qwen3.8-max",
      "input": {
        "model": "configured-qwen-high-alias",
        "reasoning_effort": "high"
      },
      "expected": {
        "model": "configured-qwen-high-alias",
        "enable_thinking": true,
        "reasoning_effort": "xhigh"
      },
      "downgrades": []
    },
    {
      "name": "positive nested budget becomes canonical",
      "model": "qwen3.8-max",
      "input": {
        "model": "configured-qwen-budget-alias",
        "thinking": {
          "type": "enabled",
          "budget_tokens": 4096
        }
      },
      "expected": {
        "model": "configured-qwen-budget-alias",
        "enable_thinking": true,
        "thinking_budget": 4096
      },
      "downgrades": []
    }
  ]
}
